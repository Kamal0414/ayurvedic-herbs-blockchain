# Server configuration
PORT=3001
NODE_ENV=development

# Hyperledger Fabric
FABRIC_NETWORK_PATH=../network
FABRIC_WALLET_PATH=./wallet
FABRIC_USER_ID=appUser
FABRIC_CHANNEL_NAME=herbtracechannel
FABRIC_CHAINCODE_NAME=herbbatch

# IPFS Configurations
IPFS_HOST=localhost
IPFS_PORT=5001
IPFS_PROTOCOL=http

# Security and CORS
JWT_SECRET=your_jwt_secret_here
CORS_ORIGIN=http://localhost:5173
