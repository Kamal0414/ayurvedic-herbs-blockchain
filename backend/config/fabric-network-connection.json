{
  "name": "fabric-network",
  "version": "1.0.0",
  "client": {
    "organization": "FarmerOrgMSP",
    "connection": {
      "timeout": {
        "peer": {
          "endorser": "300"
        }
      }
    }
  },
  "organizations": {
    "FarmerOrgMSP": {
      "mspid": "FarmerOrgMSP",
      "peers": ["peer0.farmer.example.com"],
      "certificateAuthorities": ["ca.farmer.example.com"]
    }
  },
  "peers": {
    "peer0.farmer.example.com": {
      "url": "grpc://localhost:7051",
      "tlsCACerts": { "path": "../network/crypto-config/peerOrganizations/farmer.example.com/peers/peer0.farmer.example.com/tls/ca.crt" }
    }
  },
  "certificateAuthorities": {
    "ca.farmer.example.com": {
      "url": "http://localhost:7054",
      "caName": "ca-farmer",
      "tlsCACerts": { "path": "../network/crypto-config/peerOrganizations/farmer.example.com/ca/ca.farmer.example.com-cert.pem" }
    }
  }
}
